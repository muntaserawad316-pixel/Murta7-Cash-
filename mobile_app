workflows:
  flutter-workflow:
    name: Flutter Workflow
    instance_type: mac_mini_m1
    environment:
      flutter: stable
    scripts:
      - name: Install dependencies
        script: |
          cd mobile_app
          flutter packages get
      - name: Build debug APK
        script: |
          cd mobile_app
          flutter build apk --debug
    artifacts:
      - "mobile_app/build/app/outputs/flutter-apk/app-debug.apk"
